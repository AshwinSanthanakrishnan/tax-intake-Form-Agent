# Copy this file to .env and fill in your key. .env is gitignored - never commit it.
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides
GEMINI_MODEL=gemini-3.5-flash

# Or use Claude instead: leave GEMINI_API_KEY unset and set these
# ANTHROPIC_API_KEY=your-anthropic-api-key
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
